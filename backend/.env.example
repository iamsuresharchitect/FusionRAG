# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to GitHub.

# --- Required ---
ANTHROPIC_API_KEY=sk-ant-your_key_here

# --- Claude model (change to claude-haiku-5-5 for cheaper/faster, claude-opus-5-5 for best quality) ---
CLAUDE_MODEL=claude-sonnet-5-5
MAX_TOKENS=1500

# --- Protects upload/delete. Anyone can chat; only people with this token can change documents. ---
# Generate one with:  openssl rand -hex 24
ADMIN_TOKEN=change_to_a_long_random_string

# --- Retrieval tuning (optional) ---
TOP_K=6
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_MB=25
