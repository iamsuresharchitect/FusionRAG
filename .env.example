# Root .env: read by `docker compose` itself (not by the app).
# On the VPS:  cp .env.example .env   then edit APP_DOMAIN.
# On your laptop you don't need this file at all.
# The API key lives in backend/.env, not here.

# Add the Traefik labels on top of docker-compose.yml (use ; instead of : on Windows)
COMPOSE_FILE=docker-compose.yml:deploy/docker-compose.traefik.yml

# The (sub)domain whose DNS A record points at this VPS
APP_DOMAIN=app.srmai.tech

# Keep ports 3000/8000 private; Traefik reaches the containers over Docker's network
BIND_IP=127.0.0.1
